{
  "name": "@traky-app/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the Traky logistics API",
  "keywords": [
    "traky",
    "sdk",
    "logistics",
    "shipping",
    "packages",
    "api"
  ],
  "license": "MIT",
  "author": "FasteryDev LLC (https://fastery.dev)",
  "homepage": "https://github.com/traky-app/traky-sdk-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traky-app/traky-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/traky-app/traky-sdk-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
